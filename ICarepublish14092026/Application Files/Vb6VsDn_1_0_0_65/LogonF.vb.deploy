    Private Sub LogonF_KeyDown(sender As Object, e As KeyEventArgs) Handles MyBase.KeyDown
        If e.Control AndAlso e.KeyCode = Keys.D Then
            MessageBox.Show("Ctrl+D a été pressé")
            Iptxt.Visible = True
            Iptxt.Enabled = True
        End If
    End Sub



