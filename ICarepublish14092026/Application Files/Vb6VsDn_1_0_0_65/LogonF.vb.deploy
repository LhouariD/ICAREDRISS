    Private Sub LogonF_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        Me.KeyPreview = True
        Dim Conn2 As New OleDbConnection("provider=microsoft.ace.oledb.12.0; data source =C:\MSMOROCCO\connect.accdb; Persist Security Info=False;")
        'Provider = Microsoft.ACE.OLEDB.12.0;Data Source=C:\myFolder\myAccessFile.accdb;Persist Security Info=False;
        Conn2.Open()
        Dim ChainST3 = "select * from conn"
        Dim cmd6 As New OleDbCommand(ChainST3, Conn2)
        Dim dr4 = cmd6.ExecuteReader

        '********************************************************************************************
        If dr4.Read Then
            MsgBox(dr4.Item("P_Servip"))
            If dr4.Item("P_Servip") <> "" Then
                Iptxt.Text = dr4.Item("P_Servip")
                Iptxt.Visible = False

                Iptxt.Enabled = False
                '********************************************************************************************
            Else
                '*********************** 

                Iptxt.Visible = True
                Iptxt.Enabled = True
                '*****************************
            End If
            dr4.Close()
        End If
        Conn2.Close()


        Ipadr = Iptxt.Text.Trim() & ",1433"

    End Sub

